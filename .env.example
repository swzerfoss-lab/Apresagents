# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your-api-key-here

# Admin authentication for the content portal and protected API routes.
# Production deployments require either ADMIN_API_TOKEN or ADMIN_USERNAME/ADMIN_PASSWORD.
# Local development remains unauthenticated unless one of these values is set.
ADMIN_API_TOKEN=replace-with-a-strong-random-token
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password

# Trust proxy hops for correct client IPs behind a reverse proxy (rate limiting).
# Render/Vercel enable this automatically. Set TRUST_PROXY=1 on other proxies.
# TRUST_PROXY=1

# Google Gemini API Key for Image Generation (Imagen) and Video Generation (Veo 3)
# Both services use the same API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# Alternative: GOOGLE_API_KEY (used as fallback if GEMINI_API_KEY not set)
# GOOGLE_API_KEY=your-google-api-key-here

# Brand Configuration
BRAND_NAME=Apres Feels
BRAND_DESCRIPTION=Premium and luxury skincare, muscle care, muscle recovery, and body recovery company for winter sports enthusiasts
BRAND_TONE=work hard play hard, adventurous, fun, premium, luxury
BRAND_TARGET_AUDIENCE=Males and females aged 28-55 passionate about winter sports and mountain lifestyle
BRAND_KEYWORDS=skiing,snowboarding,après-ski,mountain lifestyle,muscle recovery,skincare,winter sports,luxury,premium,natural ingredients

# Social Media Handles
INSTAGRAM_HANDLE=@apresfeels
TIKTOK_HANDLE=@apresfeels
FACEBOOK_PAGE=ApresFeels
PINTEREST_HANDLE=apresfeels

# Website
WEBSITE_URL=https://apresfeels.com

# Content Settings
DEFAULT_HASHTAG_COUNT=15
DEFAULT_POST_FREQUENCY=daily
CONTENT_THEMES=ski culture,ski travel,après scenes and parties,ski fitness,ski recovery,ski athletes and influencers,ski destinations and resorts,ski events,ski fashion,ski movies and media,skincare principles,natural healing,natural ingredients
